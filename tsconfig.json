{
    // Explicit native coverage: all 40 component directories plus shared native modules.
    // Keep additions aligned with tsconfig.build.json and jest.config.js;
    // retained upstream demo/Less tooling is not part of the RN gate.
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "lib": ["ESNext"],
        "jsx": "react-jsx",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "types": ["jest"]
    },
    "include": [
        "src/index.ts",
        "src/theme",
        "src/icons",
        "src/assets/image/rn",
        "src/components/BackTop",
        "src/components/Background",
        "src/components/Button",
        "src/components/Card",
        "src/components/Carousel",
        "src/components/Checkbox",
        "src/components/CodeBlock",
        "src/components/Collapse",
        "src/components/Countdown",
        "src/components/Cursor",
        "src/components/DatePicker",
        "src/components/Divider",
        "src/components/Drawer",
        "src/components/Footer",
        "src/components/Form",
        "src/components/Image",
        "src/components/Input",
        "src/components/Loading",
        "src/components/Modal",
        "src/components/Notification",
        "src/components/Pagination",
        "src/components/Progress",
        "src/components/Radio",
        "src/components/Select",
        "src/components/Skeleton",
        "src/components/Switch",
        "src/components/Table",
        "src/components/Tabs",
        "src/components/Tag",
        "src/components/Time",
        "src/components/TimePicker",
        "src/components/Title",
        "src/components/Typewriter",
        "src/components/Tooltip",
        "src/components/Avatar",
        "src/components/Badge",
        "src/components/Calendar",
        "src/components/CountUp",
        "src/components/Rate",
        "src/components/Upload"
    ],
    "exclude": ["node_modules", "dist"]
}
