{
    // 本 tsconfig 只覆盖**已移植到 RN** 的子集。
    //
    // 2026-09-19：34 / 34 组件已全部移植，`src/` 下不再有引用 .less / react-dom /
    // naive-icons 的 .ts(x)。已实测把 include 换成 `["src"]` 时 `typecheck` 与
    // `build` 都通过、dist 产物 400 个文件**完全一致**，所以这份穷举清单在功能上
    // 已经等价于 `["src"]`。
    //
    // 之所以暂不简化：它不是「白名单」，而是**被测范围的显式声明**，删掉后任何人
    // 往 src 里加文件都会静默进入门禁。是否简化属于基建决策，待定。
    // 在此之前，每移植/新增一个组件仍需往这里加一条（另两处见 tsconfig.build.json
    // 与 jest.config.js）。
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "lib": ["ESNext"],
        "jsx": "react-jsx",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "types": ["jest"]
    },
    "include": [
        "src/index.ts",
        "src/theme",
        "src/icons",
        "src/assets/image/rn",
        "src/components/BackTop",
        "src/components/Background",
        "src/components/Button",
        "src/components/Card",
        "src/components/Carousel",
        "src/components/Checkbox",
        "src/components/CodeBlock",
        "src/components/Collapse",
        "src/components/Countdown",
        "src/components/Cursor",
        "src/components/DatePicker",
        "src/components/Divider",
        "src/components/Drawer",
        "src/components/Footer",
        "src/components/Form",
        "src/components/Image",
        "src/components/Input",
        "src/components/Loading",
        "src/components/Modal",
        "src/components/Notification",
        "src/components/Pagination",
        "src/components/Progress",
        "src/components/Radio",
        "src/components/Select",
        "src/components/Skeleton",
        "src/components/Switch",
        "src/components/Table",
        "src/components/Tabs",
        "src/components/Tag",
        "src/components/Time",
        "src/components/TimePicker",
        "src/components/Title",
        "src/components/Typewriter",
        "src/components/Tooltip"
    ],
    "exclude": ["node_modules", "dist"]
}
